# Port d'écoute du serveur
PORT=3000

# development | production
NODE_ENV=development

# Clé secrète utilisée pour signer les sessions admin (JWT).
# Générez une longue chaîne aléatoire, par ex. avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Identifiant de connexion de l'espace admin
ADMIN_USERNAME=admin

# NE JAMAIS mettre le mot de passe en clair ici.
# Générez le hash avec :  npm run hash-password -- "VotreMotDePasse"
# puis collez le résultat ci-dessous.
ADMIN_PASSWORD_HASH=
